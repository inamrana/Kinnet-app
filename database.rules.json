{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["username", "nameLower", "createdAt"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$name": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
      }
    },
    "friendRequests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $to || auth.uid === $from)"
        }
      }
    },
    "sentRequests": {
      "$from": {
        ".read": "auth != null",
        "$to": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)"
        }
      }
    },
    "friends": {
      ".read": "auth != null",
      "$uid": {
        "$other": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $other)"
        }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && $chatId.contains(auth.uid)",
        ".write": "auth != null && $chatId.contains(auth.uid)",
        "messages": {
          ".indexOn": ["timestamp"]
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $other)"
        }
      }
    }
  }
}
