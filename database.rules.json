{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": [
        "username",
        "nameLower",
        "createdAt"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$name": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
      }
    },
    "friendRequests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $to || auth.uid === $from)"
        }
      }
    },
    "sentRequests": {
      "$from": {
        ".read": "auth != null",
        "$to": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)"
        }
      }
    },
    "friends": {
      ".read": "auth != null",
      "$uid": {
        "$other": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $other)"
        }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && $chatId.contains(auth.uid)",
        ".write": "auth != null && $chatId.contains(auth.uid)",
        "messages": {
          ".indexOn": [
            "timestamp"
          ]
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $other)"
        }
      }
    },
    "posts": {
      ".read": "auth != null",
      ".indexOn": [
        "timestamp",
        "authorId"
      ],
      "$postId": {
        ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || data.child('authorId').val() === auth.uid)",
        "reactions": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "commentCount": {
          ".write": "auth != null"
        },
        "shareCount": {
          ".write": "auth != null"
        }
      }
    },
    "postImages": {
      ".read": "auth != null",
      "$postId": {
        ".write": "auth != null && newData.parent().parent().child('posts').child($postId).child('authorId').val() === auth.uid"
      }
    },
    "comments": {
      ".read": "auth != null",
      "$postId": {
        ".indexOn": [
          "timestamp"
        ],
        "$commentId": {
          ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || data.child('authorId').val() === auth.uid)",
          "likes": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": [
          "timestamp"
        ],
        "$id": {
          ".write": "auth != null && (auth.uid === $uid || (!data.exists() && newData.child('fromUid').val() === auth.uid))"
        }
      }
    },
    "stories": {
      ".read": "auth != null",
      "$owner": {
        ".indexOn": [
          "timestamp"
        ],
        "$storyId": {
          ".write": "auth != null && auth.uid === $owner",
          "viewers": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          },
          "reactions": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        }
      }
    },
    "storyMedia": {
      ".read": "auth != null",
      "$storyId": {
        ".write": "auth != null && (newData.child('owner').val() === auth.uid || data.child('owner').val() === auth.uid)"
      }
    },
    "closeFriends": {
      "$uid": {
        ".read": "auth != null",
        "$friend": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
