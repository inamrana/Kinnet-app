<?xml version="1.0" encoding="utf-8"?>
<!-- A message from the other person: small avatar on the last of a group, grey bubble or photo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/msg_avatar"
        style="@style/Avatar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:textSize="10sp"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/msg_reply_label"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/msg_reply_quote"
            style="@style/ChatBubble.In"
            android:layout_marginTop="5dp"
            android:alpha="0.85"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/msg_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/msg_text"
                style="@style/ChatBubble.In"
                android:layout_marginEnd="12dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/msg_image_card"
                android:layout_width="200dp"
                android:layout_height="140dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:visibility="gone"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/msg_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Shared photo"
                    android:scaleType="centerCrop" />
            </androidx.cardview.widget.CardView>

            <!-- A post shared from the feed -->
            <include
                android:id="@+id/msg_post_card"
                layout="@layout/view_message_post"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/msg_heart"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_circle"
                android:elevation="2dp"
                android:importantForAccessibility="no"
                android:padding="3dp"
                android:src="@drawable/react_love"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/msg_edited"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:text="Edited"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
