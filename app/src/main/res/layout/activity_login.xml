<?xml version="1.0" encoding="utf-8"?>
<!-- 02 · Log in: warm background, recent login card, email/password, primary + outline buttons -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/form_side"
        android:paddingEnd="@dimen/form_side">

        <!-- Language picker -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="English (UK)"
                android:textSize="15sp" />

            <ImageView
                style="@style/Icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chevron_down"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- App logo tile -->
        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="37dp"
            android:background="@drawable/bg_logo_tile">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo_rings" />
        </FrameLayout>

        <TextView
            style="@style/Text.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:letterSpacing="0.06"
            android:text="RECENT LOGIN"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Recent login card -->
        <LinearLayout
            android:id="@+id/recent_login_card"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- Avatar with the red notification badge overlapping its top-right -->
            <FrameLayout
                android:layout_width="62dp"
                android:layout_height="62dp">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="bottom|start"
                    android:text="JW"
                    android:textSize="18sp" />

                <TextView
                    style="@style/Text.Bold"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jacob West"
                    android:textSize="17sp" />

                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tap to log in"
                    android:textSize="15sp" />
            </LinearLayout>

            <ImageView
                style="@style/Icon.Touch"
                android:contentDescription="@string/cd_more"
                android:src="@drawable/ic_more"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Email -->
        <LinearLayout
            style="@style/InputBox"
            android:layout_marginTop="23dp">

            <TextView
                style="@style/InputLabel"
                android:text="Mobile number or email" />

            <EditText
                android:id="@+id/input_email"
                style="@style/InputField"
                android:autofillHints="emailAddress"
                android:hint="Mobile number or email"
                android:inputType="textEmailAddress"
                android:text="jacob.west@mail.com" />
        </LinearLayout>

        <!-- Password with show/hide eye -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/InputLabel"
                    android:text="Password" />

                <EditText
                    android:id="@+id/input_password"
                    style="@style/InputField"
                    android:autofillHints="password"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:text="kinnect2026" />
            </LinearLayout>

            <ImageView
                style="@style/Icon.Touch"
                android:contentDescription="@string/cd_show_password"
                android:src="@drawable/ic_eye"
                android:tint="@color/text_primary" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_login"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="13dp"
            android:text="Log in"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/link_forgot"
            style="@style/Text.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="6dp"
            android:text="Forgot password?"
            android:textSize="16sp" />

        <!-- Pushes the bottom group down on tall screens -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <Button
            android:id="@+id/btn_create_account"
            style="@style/Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="49dp"
            android:text="Create new account"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                style="@style/Icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_logo_rings"
                android:tint="@color/text_secondary" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Kinnect · from SMD" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
