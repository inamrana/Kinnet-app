<?xml version="1.0" encoding="utf-8"?>
<!-- 12 · Your story: your shared story with reactions and viewer actions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/your_story_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/dark_pill"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/scene_green_tall" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_track"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.84"
                        android:background="@drawable/bg_progress_fill" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.16" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="6dp">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/teal"
                    android:text="JW"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:alpha="0.85"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your story"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="11h · Close friends"
                            android:textColor="@color/white"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_close"
                    style="@style/Icon.Touch"
                    android:contentDescription="@string/cd_close"
                    android:src="@drawable/ic_close"
                    android:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- Text sticker placed on the photo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="26dp"
            android:background="@drawable/bg_sticker_white"
            android:backgroundTint="@color/badge_red"
            android:elevation="2dp"
            android:fontFamily="@font/bricolage_extrabold"
            android:includeFontPadding="false"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:rotation="2"
            android:text="Saturday plans"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:translationY="56dp" />

        <!-- Floating hearts from viewers' reactions -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="30dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="30dp"
                android:layout_marginBottom="168dp"
                android:alpha="0.35"
                android:importantForAccessibility="no"
                android:src="@drawable/react_love" />
            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="128dp"
                android:alpha="0.45"
                android:importantForAccessibility="no"
                android:src="@drawable/react_love" />
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="38dp"
                android:layout_marginBottom="84dp"
                android:alpha="0.6"
                android:importantForAccessibility="no"
                android:src="@drawable/react_love" />
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="38dp"
                android:alpha="0.85"
                android:importantForAccessibility="no"
                android:src="@drawable/react_love" />
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="44dp"
                android:layout_marginBottom="0dp"
                android:alpha="1"
                android:importantForAccessibility="no"
                android:src="@drawable/react_love" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Viewers + story actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/story_viewers"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="0dp"
                    android:backgroundTint="@color/av_crimson"
                    android:foreground="@drawable/bg_avatar_ring_dark"
                    android:text="AK"
                    android:textSize="10sp" />

                <TextView
                    style="@style/Avatar"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="-8dp"
                    android:backgroundTint="@color/av_purple"
                    android:foreground="@drawable/bg_avatar_ring_dark"
                    android:text="LM"
                    android:textSize="10sp" />

                <TextView
                    style="@style/Avatar"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="-8dp"
                    android:backgroundTint="@color/av_green"
                    android:foreground="@drawable/bg_avatar_ring_dark"
                    android:text="OF"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Seen by 24"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/story_create"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                style="@style/Icon"
                android:src="@drawable/ic_reel"
                android:tint="@color/white" />

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Create"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/story_highlight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                style="@style/Icon"
                android:src="@drawable/ic_heart"
                android:tint="@color/white" />

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Highlight"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/story_send"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                style="@style/Icon"
                android:src="@drawable/ic_send"
                android:tint="@color/white" />

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Send"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/story_more"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                style="@style/Icon"
                android:src="@drawable/ic_more"
                android:tint="@color/white" />

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="More"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
