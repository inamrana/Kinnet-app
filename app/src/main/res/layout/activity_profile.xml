<?xml version="1.0" encoding="utf-8"?>
<!-- 15 · Profile: cover photo, overlapping avatar, actions, details and friends -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/Icon.Touch"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Jacob West"
            android:textSize="21sp" />

        <ImageView
            style="@style/Icon.Touch"
            android:contentDescription="@string/cd_search"
            android:src="@drawable/ic_search" />
    </LinearLayout>

    <View style="@style/Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Cover photo with the avatar overlapping its bottom edge -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="196dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Cover photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/scene_teal_wide" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="#E6F3F1ED"
                    android:contentDescription="@string/cd_camera"
                    android:padding="8dp"
                    android:src="@drawable/ic_camera" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="152dp"
                android:layout_height="152dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="-122dp">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_profile_avatar"
                    android:backgroundTint="@null"
                    android:text="JW"
                    android:textSize="52sp" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/surface_pill"
                    android:contentDescription="@string/cd_camera"
                    android:padding="8dp"
                    android:src="@drawable/ic_camera" />
            </FrameLayout>

            <TextView
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:text="Jacob West"
                android:textSize="30sp" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:text="@string/profile_friends_count"
                android:textSize="15sp" />

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:text="Digital goodies designer. Everything is designed."
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:id="@+id/btn_add_story"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary_square"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_plus"
                        android:tint="@color/white" />

                    <TextView
                        style="@style/Text.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Add to story"
                        android:textColor="@color/white"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_edit_profile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_grey"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_pencil"
                        android:tint="@color/text_primary" />

                    <TextView
                        style="@style/Text.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Edit profile"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_grey"
                    android:contentDescription="@string/cd_more"
                    android:padding="12dp"
                    android:src="@drawable/ic_more" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Chip.Selected"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Posts"
                    android:textSize="15sp" />
                <TextView
                    style="@style/Chip"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@null"
                    android:textColor="@color/text_secondary"
                    android:text="Photos"
                    android:textSize="15sp" />
                <TextView
                    style="@style/Chip"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@null"
                    android:textColor="@color/text_secondary"
                    android:text="Videos"
                    android:textSize="15sp" />
                <TextView
                    style="@style/Chip"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@null"
                    android:textColor="@color/text_secondary"
                    android:text="Groups"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                style="@style/Divider"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp" />

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:text="Details" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    style="@style/Icon"
                    android:src="@drawable/ic_briefcase" />

                <TextView
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/works_pixellz"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    style="@style/Icon"
                    android:src="@drawable/ic_school" />

                <TextView
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/studied_fast"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    style="@style/Icon"
                    android:src="@drawable/ic_pin" />

                <TextView
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/lives_karachi"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    style="@style/Icon"
                    android:src="@drawable/ic_clock" />

                <TextView
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Joined March 2019"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Friends" />

                <TextView
                    style="@style/Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Find friends"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:text="834 friends" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="0dp"
                    android:layout_height="128dp"
                    android:layout_marginStart="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_rounded_12"
                    android:backgroundTint="@color/av_purple"
                    android:gravity="center"
                    android:text="LM"
                    android:textSize="36sp" />
                <TextView
                    style="@style/Avatar"
                    android:layout_width="0dp"
                    android:layout_height="128dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_rounded_12"
                    android:backgroundTint="@color/av_crimson"
                    android:gravity="center"
                    android:text="AK"
                    android:textSize="36sp" />
                <TextView
                    style="@style/Avatar"
                    android:layout_width="0dp"
                    android:layout_height="128dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_rounded_12"
                    android:backgroundTint="@color/av_green"
                    android:gravity="center"
                    android:text="OF"
                    android:textSize="36sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
