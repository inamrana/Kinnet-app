<?xml version="1.0" encoding="utf-8"?>
<!-- 21 · Chat with Aisha: header with call buttons, message thread, typing indicator, composer -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/Icon.Touch"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back"
            android:tint="@color/teal" />

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp">

            <TextView
                android:id="@+id/chat_header_avatar"
                style="@style/Avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:backgroundTint="@color/av_crimson"
                android:text="AK"
                android:textSize="15sp" />

            <View
                android:id="@+id/chat_header_online"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_online_dot"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_header_name"
                style="@style/Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aisha Khan"
                android:textSize="17sp" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/chat_header_status"
                android:layout_marginTop="3dp"
                android:text="Active now" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_call"
            style="@style/Icon.Touch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/cd_call"
            android:padding="10dp"
            android:src="@drawable/ic_phone"
            android:tint="@color/teal" />

        <ImageView
            android:id="@+id/btn_video"
            style="@style/Icon.Touch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/cd_video_call"
            android:padding="10dp"
            android:src="@drawable/ic_video"
            android:tint="@color/teal" />

        <ImageView
            android:id="@+id/btn_info"
            style="@style/Icon.Touch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/cd_info"
            android:padding="10dp"
            android:src="@drawable/ic_info"
            android:tint="@color/teal" />
    </LinearLayout>

    <View style="@style/Divider" />

    <ScrollView
        android:id="@+id/chat_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <!-- Conversation intro -->
            <TextView
                android:id="@+id/chat_intro_avatar"
                style="@style/Avatar"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:backgroundTint="@color/av_crimson"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="22dp"
                android:text="AK"
                android:textSize="32sp" />

            <TextView
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:id="@+id/chat_intro_name"
                android:layout_marginTop="16dp"
                android:text="Aisha Khan"
                android:textSize="25sp" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:id="@+id/chat_intro_info"
                android:layout_marginTop="8dp"
                android:text="You're friends on Kinnect" />

            <TextView
                style="@style/Text.SemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:id="@+id/chat_intro_date"
                android:letterSpacing="0.04"
                android:text="TODAY 4:49 PM"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Messages, added live from chats/{chatId}/messages -->
            <LinearLayout
                android:id="@+id/messages_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Replying to / Editing bar, shown above the composer when needed -->
    <LinearLayout
        android:id="@+id/reply_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_warm"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/reply_title"
                style="@style/Text.SemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/reply_text"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/reply_cancel"
            style="@style/Text.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Cancel"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            style="@style/Icon.Touch"
            android:contentDescription="More"
            android:src="@drawable/ic_plus_circle"
            android:tint="@color/teal" />

        <ImageView
            style="@style/Icon.Touch"
            android:contentDescription="@string/cd_camera"
            android:src="@drawable/ic_camera"
            android:tint="@color/teal" />

        <ImageView
            android:id="@+id/btn_send_image"
            style="@style/Icon.Touch"
            android:contentDescription="@string/cd_photo"
            android:src="@drawable/ic_image"
            android:tint="@color/teal" />

        <ImageView
            style="@style/Icon.Touch"
            android:contentDescription="Voice message"
            android:src="@drawable/ic_mic"
            android:tint="@color/teal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="10dp">

            <EditText
                android:id="@+id/input_message"
                style="@style/InputField"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="Aa"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:paddingTop="0dp" />

            <ImageView
                style="@style/Icon"
                android:src="@drawable/ic_smile"
                android:tint="@color/teal" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_send"
            style="@style/Icon.Touch"
            android:contentDescription="Send a like"
            android:src="@drawable/ic_like"
            android:tint="@color/teal" />
    </LinearLayout>
</LinearLayout>
