<?xml version="1.0" encoding="utf-8"?>
<!-- One conversation in Chats: avatar with online dot, name, last message · time, unread dot -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="20dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp">

        <TextView
            android:id="@+id/chat_avatar"
            style="@style/Avatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:textSize="22sp" />

        <View
            android:id="@+id/chat_online"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_online_dot"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chat_name"
            style="@style/Text.SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/chat_preview"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:id="@+id/chat_unread"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/teal"
        android:visibility="gone" />
</LinearLayout>
