<?xml version="1.0" encoding="utf-8"?>
<!-- One post in the Home feed (design screen 04): author row, text, multi-photo grid with
     the "+N" overlay, live reaction summary and Like / Comment / Share -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Author row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/post_avatar"
            style="@style/Avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="yes"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/post_author_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/post_author"
                style="@style/Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/post_time"
                    style="@style/Text.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    style="@style/Icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_globe"
                    android:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/post_more"
            style="@style/Icon.Touch"
            android:contentDescription="@string/cd_more"
            android:src="@drawable/ic_more" />

        <ImageView
            android:id="@+id/post_hide"
            style="@style/Icon.Touch"
            android:contentDescription="Hide post"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <TextView
        android:id="@+id/post_text"
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textSize="16sp" />

    <!-- Text post on a coloured background -->
    <TextView
        android:id="@+id/post_bg_text"
        style="@style/Text.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:minHeight="240dp"
        android:padding="28dp"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:visibility="gone" />

    <!-- Photo grid: one tall photo + two stacked, "+N" overlay on the last one -->
    <LinearLayout
        android:id="@+id/post_photos"
        android:layout_width="match_parent"
        android:layout_height="@dimen/feed_grid_height"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/photo_a"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/surface_pill"
            android:contentDescription="Post photo 1"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/photo_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/photo_b"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/surface_pill"
                android:contentDescription="Post photo 2"
                android:scaleType="centerCrop" />

            <FrameLayout
                android:id="@+id/photo_c_frame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="3dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/photo_c"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/surface_pill"
                    android:contentDescription="Post photo 3"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/photo_more"
                    style="@style/Text.Bold"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66000000"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Reaction summary -->
    <LinearLayout
        android:id="@+id/post_summary"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <include layout="@layout/view_reaction_stack" />

        <TextView
            android:id="@+id/post_reaction_text"
            style="@style/Text.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/post_comment_count"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        style="@style/Divider"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp" />

    <include layout="@layout/view_post_actions" />

    <View style="@style/Divider.Thick" />
</LinearLayout>
