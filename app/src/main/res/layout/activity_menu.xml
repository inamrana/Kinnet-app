<?xml version="1.0" encoding="utf-8"?>
<!-- 19 · Menu: profile card, shortcut grid, expandable sections and Log out -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            style="@style/Text.Display"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Menu"
            android:textSize="30sp" />

        <include layout="@layout/view_header_actions" />
    </LinearLayout>

    <include layout="@layout/view_top_tabs" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_warm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Your profile card -->
            <LinearLayout
                android:id="@+id/menu_profile"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card_plain"
                android:elevation="1dp"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:text="JW"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jacob West"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="See your profile"
                        android:textSize="15sp" />
                </LinearLayout>

                <ImageView
                    style="@style/Icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <TextView
                style="@style/Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:text="All shortcuts"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:id="@+id/menu_memories"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_plain"
                    android:elevation="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:src="@drawable/ic_clock"
                        android:tint="@color/teal" />

                    <TextView
                        style="@style/Text.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Memories"
                        android:textSize="16sp" />
                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/menu_saved"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_plain"
                    android:elevation="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:src="@drawable/ic_bookmark"
                        android:tint="@color/av_purple" />

                    <TextView
                        style="@style/Text.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Saved"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:id="@+id/menu_groups"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_plain"
                    android:elevation="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:src="@drawable/ic_friends"
                        android:tint="@color/av_indigo" />

                    <TextView
                        style="@style/Text.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Groups"
                        android:textSize="16sp" />
                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/menu_marketplace"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_plain"
                    android:elevation="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:src="@drawable/ic_store"
                        android:tint="@color/av_green" />

                    <TextView
                        style="@style/Text.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Marketplace"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:id="@+id/menu_friends"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_plain"
                    android:elevation="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:src="@drawable/ic_person"
                        android:tint="@color/teal" />

                    <TextView
                        style="@style/Text.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Friends"
                        android:textSize="16sp" />
                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/menu_events"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_plain"
                    android:elevation="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:src="@drawable/ic_calendar"
                        android:tint="@color/sw_orange" />

                    <TextView
                        style="@style/Text.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Events"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                style="@style/Button.Grey"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="14dp"
                android:backgroundTint="#E8E5DF"
                android:text="See more" />

            <View
                style="@style/Divider"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/surface_pill"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_help"
                    android:tint="@color/text_primary" />

                <TextView
                    style="@style/Text.Medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Help &amp; support"
                    android:textSize="17sp" />

                <ImageView
                    style="@style/Icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="@color/text_secondary" />
            </LinearLayout>

            <View
                style="@style/Divider"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/surface_pill"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/text_primary" />

                <TextView
                    style="@style/Text.Medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Settings &amp; privacy"
                    android:textSize="17sp" />

                <ImageView
                    style="@style/Icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="@color/text_secondary" />
            </LinearLayout>

            <View
                style="@style/Divider"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/surface_pill"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_grid"
                    android:tint="@color/text_primary" />

                <TextView
                    style="@style/Text.Medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Also from SMD"
                    android:textSize="17sp" />

                <ImageView
                    style="@style/Icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_btn_grey"
                android:backgroundTint="#E8E5DF"
                android:clickable="true"
                android:contentDescription="Log out"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:rotation="180"
                    android:src="@drawable/ic_logout" />

                <TextView
                    style="@style/Text.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Log out"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
