<?xml version="1.0" encoding="utf-8"?>
<!-- Search + Chats round buttons at the right of every main header.
     The red "3" badge overlaps the top-right of the chats button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/btn_search"
        style="@style/IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/cd_search"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_search" />

    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="6dp">

        <ImageView
            android:id="@+id/btn_messenger"
            style="@style/IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|start"
            android:contentDescription="@string/cd_chats"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_messenger" />

        <TextView
            style="@style/Text.Bold"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/white"
            android:textSize="11sp" />
    </FrameLayout>
</LinearLayout>
