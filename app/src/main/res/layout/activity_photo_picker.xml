<?xml version="1.0" encoding="utf-8"?>
<!-- 08 · Photo picker: preview of the focused item, the device gallery in a 4-column grid
     with selection numbers, and Gallery / Photo / Video tabs -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/picker_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btn_cancel"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:padding="4dp"
            android:text="Cancel"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recents"
                android:textSize="20sp" />

            <ImageView
                style="@style/Icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_next"
            style="@style/Text.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:padding="4dp"
            android:text="Next"
            android:textSize="16sp" />
    </FrameLayout>

    <!-- Large preview of the focused photo or video -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/picker_preview_height"
        android:background="@color/surface_pill">

        <ImageView
            android:id="@+id/picker_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Selected photo preview"
            android:scaleType="centerCrop" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="13dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#B3332A20"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_expand"
            android:tint="@color/white" />

        <LinearLayout
            android:id="@+id/btn_select_multiple"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="13dp"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <ImageView
                style="@style/Icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_copy"
                android:tint="@color/white" />

            <TextView
                android:id="@+id/select_multiple_label"
                style="@style/Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.06"
                android:text="SELECT MULTIPLE"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/picker_message"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Gallery grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/picker_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_weight="1" />

    <View style="@style/Divider" />

    <!-- Source tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/tab_gallery"
            style="@style/PickerTab">

            <View
                android:id="@+id/tab_gallery_line"
                style="@style/PickerTabLine" />

            <TextView
                android:id="@+id/tab_gallery_label"
                style="@style/PickerTabLabel"
                android:text="Gallery" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tab_photo"
            style="@style/PickerTab">

            <View
                android:id="@+id/tab_photo_line"
                style="@style/PickerTabLine" />

            <TextView
                android:id="@+id/tab_photo_label"
                style="@style/PickerTabLabel"
                android:text="Photo" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tab_video"
            style="@style/PickerTab">

            <View
                android:id="@+id/tab_video_line"
                style="@style/PickerTabLine" />

            <TextView
                android:id="@+id/tab_video_label"
                style="@style/PickerTabLabel"
                android:text="Video" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
