<?xml version="1.0" encoding="utf-8"?>
<!-- 08 · Photo picker: preview, 4-column gallery grid with selection order, Gallery/Photo/Video tabs -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/picker_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btn_cancel"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:padding="4dp"
            android:text="Cancel"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recents"
                android:textSize="20sp" />

            <ImageView
                style="@style/Icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_next"
            style="@style/Text.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:padding="4dp"
            android:text="Next (2)"
            android:textSize="16sp" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Large preview of the focused photo -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="328dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Selected photo preview"
                    android:scaleType="centerCrop"
                    android:src="@drawable/scene_sand" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="13dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="#B3332A20"
                    android:contentDescription="Expand"
                    android:padding="10dp"
                    android:src="@drawable/ic_expand"
                    android:tint="@color/white" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="13dp"
                    android:background="@drawable/bg_btn_primary"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_copy"
                        android:tint="@color/white" />

                    <TextView
                        style="@style/Text.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="0.06"
                        android:text="SELECT MULTIPLE"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Gallery grid: square cells, 3dp gutters -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp">

                <FrameLayout
                    android:id="@+id/photo_1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="0dp"
                    android:foreground="@drawable/bg_selected_photo"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/photo_2"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gallery photo 1"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_sand" />

                    <TextView
                        style="@style/Text.Bold"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="5dp"
                        android:background="@drawable/bg_select_num"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/photo_2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@id/photo_1"
                    app:layout_constraintEnd_toStartOf="@id/photo_3"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gallery photo 2"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_teal" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_select_ring" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/photo_3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@id/photo_2"
                    app:layout_constraintEnd_toStartOf="@id/photo_4"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gallery photo 3"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_lavender" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_select_ring" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/photo_4"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@id/photo_3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gallery photo 4"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_blue" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_select_ring" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/photo_5"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="3dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/photo_6"
                    app:layout_constraintTop_toBottomOf="@id/photo_1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gallery photo 5"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_green" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_select_ring" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/photo_6"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="3dp"
                    android:foreground="@drawable/bg_selected_photo"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@id/photo_5"
                    app:layout_constraintEnd_toStartOf="@id/photo_7"
                    app:layout_constraintTop_toBottomOf="@id/photo_2">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gallery photo 6"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_rose" />

                    <TextView
                        style="@style/Text.Bold"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="5dp"
                        android:background="@drawable/bg_select_num"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/photo_7"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="3dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@id/photo_6"
                    app:layout_constraintEnd_toStartOf="@id/photo_8"
                    app:layout_constraintTop_toBottomOf="@id/photo_3">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gallery photo 7"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_night" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_select_ring" />

                    <TextView
                        style="@style/Text.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="6dp"
                        android:text="0:23"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/photo_8"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="3dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@id/photo_7"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/photo_4">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gallery photo 8"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_teal" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_select_ring" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/photo_9"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="3dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/photo_10"
                    app:layout_constraintTop_toBottomOf="@id/photo_5">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gallery photo 9"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_lavender" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_select_ring" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/photo_10"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="3dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@id/photo_9"
                    app:layout_constraintEnd_toStartOf="@id/photo_11"
                    app:layout_constraintTop_toBottomOf="@id/photo_6">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gallery photo 10"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_sand" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_select_ring" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/photo_11"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="3dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@id/photo_10"
                    app:layout_constraintEnd_toStartOf="@id/photo_12"
                    app:layout_constraintTop_toBottomOf="@id/photo_7">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gallery photo 11"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_green" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_select_ring" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/photo_12"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="3dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@id/photo_11"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/photo_8">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gallery photo 12"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_blue" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_select_ring" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/photo_13"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="3dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/photo_14"
                    app:layout_constraintTop_toBottomOf="@id/photo_9">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gallery photo 13"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_rose" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_select_ring" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/photo_14"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="3dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@id/photo_13"
                    app:layout_constraintEnd_toStartOf="@id/photo_15"
                    app:layout_constraintTop_toBottomOf="@id/photo_10">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gallery photo 14"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_night" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_select_ring" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/photo_15"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="3dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@id/photo_14"
                    app:layout_constraintEnd_toStartOf="@id/photo_16"
                    app:layout_constraintTop_toBottomOf="@id/photo_11">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gallery photo 15"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_blue" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_select_ring" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/photo_16"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="3dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toEndOf="@id/photo_15"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/photo_12">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gallery photo 16"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_sand" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_select_ring" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>

    <View style="@style/Divider" />

    <!-- Source tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground">

            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/teal"
                android:visibility="visible" />

            <TextView
                style="@style/Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Gallery"
                android:textColor="@color/teal"
                android:textSize="17sp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground">

            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/teal"
                android:visibility="invisible" />

            <TextView
                style="@style/Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Photo"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground">

            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/teal"
                android:visibility="invisible" />

            <TextView
                style="@style/Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Video"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
