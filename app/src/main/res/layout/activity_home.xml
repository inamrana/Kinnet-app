<?xml version="1.0" encoding="utf-8"?>
<!-- 04 · Home feed: header, top tabs, composer, stories rail, multi-photo post -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Header: wordmark + search / chats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="17dp"
        android:paddingEnd="16dp">

        <TextView
            style="@style/Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/bricolage_extrabold"
            android:letterSpacing="-0.03"
            android:text="kinnect"
            android:textColor="@color/teal"
            android:textSize="31sp" />

        <include layout="@layout/view_header_actions" />
    </LinearLayout>

    <include layout="@layout/view_top_tabs" />

    <ScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Composer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/composer_avatar"
                    style="@style/Avatar"
                    android:importantForAccessibility="yes"
                    android:contentDescription="Your profile"
                    android:text="JW"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/composer_input"
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_outline"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:text="What's on your mind, Jacob?"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/composer_photo"
                    style="@style/Icon.Touch"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@string/cd_photo"
                    android:src="@drawable/ic_image"
                    android:tint="@color/teal" />
            </LinearLayout>

            <View style="@style/Divider.Thick" />

            <!-- Stories rail -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Create story: avatar on tint, "+" button overlapping the split -->
                    <FrameLayout
                        android:id="@+id/story_create"
                        android:layout_width="104dp"
                        android:layout_height="175dp"
                        android:background="@drawable/bg_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="118dp"
                            android:layout_margin="1dp"
                            android:background="@drawable/bg_story_top" />

                        <TextView
                            style="@style/Avatar"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="26dp"
                            android:text="JW"
                            android:textSize="22sp" />

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="101dp"
                            android:background="@drawable/bg_circle_ring_white"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_plus"
                            android:tint="@color/white" />

                        <TextView
                            style="@style/Text.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="13dp"
                            android:text="Create story"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <!-- Omar's story -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/story_omar"
                        style="@style/StoryCard">

                        <ImageView
                            style="@style/StoryImage"
                            android:src="@drawable/scene_night_tall" />

                        <View style="@style/StoryShade" />

                        <TextView
                            style="@style/StoryAvatar"
                            android:backgroundTint="@color/av_green"
                            android:text="OF" />

                        <TextView
                            style="@style/StoryName"
                            android:text="Omar Farooq" />
                    </androidx.cardview.widget.CardView>

                    <!-- Sara's story -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/story_sara"
                        style="@style/StoryCard">

                        <ImageView
                            style="@style/StoryImage"
                            android:src="@drawable/scene_rose_tall" />

                        <View style="@style/StoryShade" />

                        <TextView
                            style="@style/StoryAvatar"
                            android:backgroundTint="@color/av_indigo"
                            android:text="SI" />

                        <TextView
                            style="@style/StoryName"
                            android:text="Sara Iqbal" />
                    </androidx.cardview.widget.CardView>

                    <!-- Hamza's story -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/story_hamza"
                        style="@style/StoryCard">

                        <ImageView
                            style="@style/StoryImage"
                            android:src="@drawable/scene_green_tall" />

                        <View style="@style/StoryShade" />

                        <TextView
                            style="@style/StoryAvatar"
                            android:backgroundTint="@color/av_brown"
                            android:text="HA" />

                        <TextView
                            style="@style/StoryName"
                            android:text="Hamza Ali" />
                    </androidx.cardview.widget.CardView>

                    <!-- Aisha's story -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/story_aisha"
                        style="@style/StoryCard">

                        <ImageView
                            style="@style/StoryImage"
                            android:src="@drawable/scene_blue_tall" />

                        <View style="@style/StoryShade" />

                        <TextView
                            style="@style/StoryAvatar"
                            android:backgroundTint="@color/av_crimson"
                            android:text="AK" />

                        <TextView
                            style="@style/StoryName"
                            android:text="Aisha Khan" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </HorizontalScrollView>

            <View style="@style/Divider.Thick" />

            <!-- ===== Post ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include
                    layout="@layout/view_post_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ImageView
                    style="@style/Icon.Touch"
                    android:layout_marginTop="14dp"
                    android:contentDescription="@string/cd_more"
                    android:src="@drawable/ic_more" />

                <ImageView
                    style="@style/Icon.Touch"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/cd_close"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <TextView
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/post_body"
                android:textSize="16sp" />

            <!-- Photo grid: one tall photo + two stacked, "+4" overlay on the last one -->
            <LinearLayout
                android:id="@+id/post_photos"
                android:layout_width="match_parent"
                android:layout_height="@dimen/feed_grid_height"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Beach photo 1"
                    android:scaleType="centerCrop"
                    android:src="@drawable/scene_sand" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:contentDescription="Beach photo 2"
                        android:scaleType="centerCrop"
                        android:src="@drawable/scene_teal" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="3dp"
                        android:layout_weight="1">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Beach photo 3"
                            android:scaleType="centerCrop"
                            android:src="@drawable/scene_mauve" />

                        <TextView
                            style="@style/Text.Bold"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#33000000"
                            android:gravity="center"
                            android:text="+4"
                            android:textColor="@color/white"
                            android:textSize="30sp" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Reaction summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <include layout="@layout/view_reaction_stack" />

                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Aisha and 1.2K others"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/post_comment_count"
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="86 comments · 12 shares"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                style="@style/Divider"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp" />

            <include layout="@layout/view_post_actions" />

            <View style="@style/Divider.Thick" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
