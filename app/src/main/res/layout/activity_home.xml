<?xml version="1.0" encoding="utf-8"?>
<!-- 04 · Home feed: header, top tabs, composer, live stories rail and live posts feed -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Header: wordmark + search / chats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="17dp"
        android:paddingEnd="16dp">

        <TextView
            style="@style/Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/bricolage_extrabold"
            android:letterSpacing="-0.03"
            android:text="kinnect"
            android:textColor="@color/teal"
            android:textSize="31sp" />

        <include layout="@layout/view_header_actions" />
    </LinearLayout>

    <include layout="@layout/view_top_tabs" />

    <ScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Composer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/composer_avatar"
                    style="@style/Avatar"
                    android:importantForAccessibility="yes"
                    android:contentDescription="Your profile"
                    android:text="JW"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/composer_input"
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_outline"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:text="What's on your mind, Jacob?"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/composer_photo"
                    style="@style/Icon.Touch"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@string/cd_photo"
                    android:src="@drawable/ic_image"
                    android:tint="@color/teal" />
            </LinearLayout>

            <View style="@style/Divider.Thick" />

            <!-- Stories rail -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/stories_rail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Create story: avatar on tint, "+" button overlapping the split -->
                    <FrameLayout
                        android:id="@+id/story_create"
                        android:layout_width="104dp"
                        android:layout_height="175dp"
                        android:background="@drawable/bg_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="118dp"
                            android:layout_margin="1dp"
                            android:background="@drawable/bg_story_top" />

                        <TextView
                            android:id="@+id/story_create_avatar"
                            style="@style/Avatar"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="26dp"
                            android:text="JW"
                            android:textSize="22sp" />

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="101dp"
                            android:background="@drawable/bg_circle_ring_white"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_plus"
                            android:tint="@color/white" />

                        <TextView
                            style="@style/Text.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="13dp"
                            android:text="Create story"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <!-- Friends' stories are added here by HomeActivity -->
                </LinearLayout>
            </HorizontalScrollView>

            <View style="@style/Divider.Thick" />

            <!-- Posts from you and your friends, newest first (item_post) -->
            <LinearLayout
                android:id="@+id/feed_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/feed_empty"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:text="No posts yet. Share something or add friends to see their posts here."
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
