<?xml version="1.0" encoding="utf-8"?>
<!-- 06 · Comments: threaded replies with connector lines, reaction chips and a reply composer -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/comments_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/Icon.Touch"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Comments" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="11dp">

            <TextView
                style="@style/Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Most relevant"
                android:textSize="14sp" />

            <ImageView
                style="@style/Icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>
    </LinearLayout>

    <View style="@style/Divider" />

    <!-- Reactions summary -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <include layout="@layout/view_reaction_stack" />

        <TextView
            style="@style/Text.Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="1.2K" />

        <ImageView
            style="@style/Icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <View style="@style/Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="2dp"
                    android:backgroundTint="@color/av_crimson"
                    android:text="AK"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/comment_aisha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="18dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_bubble"
                            android:orientation="vertical"
                            android:paddingStart="13dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="11dp">

                            <TextView
                                style="@style/Text.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Aisha Khan"
                                android:textSize="15sp" />

                            <TextView
                                style="@style/Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="3dp"
                                android:text="That sky is unreal. Which part of the beach was this?"
                                android:textSize="15sp" />
                        </LinearLayout>
                        <!-- Reaction count chip overlapping the bubble's bottom-right corner -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_reaction_chip"
                            android:elevation="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="3dp"
                            android:paddingEnd="7dp">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="0dp"
                                android:foreground="@drawable/bg_reaction_ring"
                                android:src="@drawable/react_like" />
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="-4dp"
                                android:foreground="@drawable/bg_reaction_ring"
                                android:src="@drawable/react_love" />

                            <TextView
                                style="@style/Text.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="24"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="0dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2h" />

                        <TextView
                            style="@style/Text.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Like"
                            android:textColor="@color/teal"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/Text.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Reply"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:paddingStart="33dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="-30dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/thread_elbow" />
                <TextView
                    style="@style/Avatar"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="2dp"
                    android:backgroundTint="@color/av_purple"
                    android:text="LM"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="18dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_bubble"
                            android:orientation="vertical"
                            android:paddingStart="13dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="11dp">

                            <TextView
                                style="@style/Text.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lina Marsh"
                                android:textSize="15sp" />

                            <TextView
                                style="@style/Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="3dp"
                                android:text="Near the old pier, right before the rain started!"
                                android:textSize="15sp" />
                        </LinearLayout>
                        <!-- Reaction count chip overlapping the bubble's bottom-right corner -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_reaction_chip"
                            android:elevation="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="3dp"
                            android:paddingEnd="7dp">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="0dp"
                                android:foreground="@drawable/bg_reaction_ring"
                                android:src="@drawable/react_haha" />

                            <TextView
                                style="@style/Text.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="3"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="0dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1h" />

                        <TextView
                            style="@style/Text.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Like"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/Text.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Reply"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:paddingStart="33dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="-30dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/thread_elbow" />
                <TextView
                    style="@style/Avatar"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="2dp"
                    android:backgroundTint="@color/av_steel"
                    android:text="ZR"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="0dp"
                            android:layout_marginBottom="0dp"
                            android:background="@drawable/bg_bubble"
                            android:orientation="vertical"
                            android:paddingStart="13dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="11dp">

                            <TextView
                                style="@style/Text.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Zain Raza"
                                android:textSize="15sp" />

                            <TextView
                                style="@style/Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/mention_reply"
                                android:textSize="15sp" />
                        </LinearLayout>

                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="7dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="45m" />

                        <TextView
                            style="@style/Text.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Like"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/Text.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Reply"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="33dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="-34dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/thread_elbow" />

                <TextView
                    style="@style/Text.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View 6 more replies"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="2dp"
                    android:backgroundTint="@color/av_brown"
                    android:text="HA"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="0dp"
                            android:layout_marginBottom="0dp"
                            android:background="@drawable/bg_bubble"
                            android:orientation="vertical"
                            android:paddingStart="13dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="11dp">

                            <TextView
                                style="@style/Text.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hamza Ali"
                                android:textSize="15sp" />

                            <TextView
                                style="@style/Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="3dp"
                                android:text="Same spot, one year ago:"
                                android:textSize="15sp" />
                        </LinearLayout>

                    </FrameLayout>
                    <androidx.cardview.widget.CardView
                        android:layout_width="180dp"
                        android:layout_height="124dp"
                        android:layout_marginTop="6dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Photo in comment"
                            android:scaleType="centerCrop"
                            android:src="@drawable/scene_blue" />
                    </androidx.cardview.widget.CardView>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="7dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1h" />

                        <TextView
                            style="@style/Text.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Like"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/Text.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Reply"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="2dp"
                    android:backgroundTint="@color/av_olive"
                    android:text="MC"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="0dp"
                            android:layout_marginBottom="0dp"
                            android:background="@drawable/bg_bubble"
                            android:orientation="vertical"
                            android:paddingStart="13dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="11dp">

                            <TextView
                                style="@style/Text.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Maya Chen"
                                android:textSize="15sp" />

                            <TextView
                                style="@style/Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="3dp"
                                android:text="Framing this one."
                                android:textSize="15sp" />
                        </LinearLayout>

                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="7dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30m" />

                        <TextView
                            style="@style/Text.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Like"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/Text.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Reply"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View style="@style/Divider" />

    <!-- Replying-to bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="20dp">

        <TextView
            style="@style/Text.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/replying_to" />

        <TextView
            style="@style/Text.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Reply composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <ImageView
            style="@style/Icon.Touch"
            android:contentDescription="@string/cd_camera"
            android:src="@drawable/ic_camera"
            android:tint="@color/teal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="10dp">

            <EditText
                android:id="@+id/input_reply"
                style="@style/InputField"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="Write a reply…"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:paddingTop="0dp"
                android:textSize="16sp" />

            <ImageView
                style="@style/Icon"
                android:src="@drawable/ic_smile" />
        </LinearLayout>

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/teal"
            android:contentDescription="@string/cd_send"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:src="@drawable/ic_send"
            android:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
