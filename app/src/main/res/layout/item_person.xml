<?xml version="1.0" encoding="utf-8"?>
<!-- One person row (Search results, People you may know, Your friends) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/person_avatar"
        style="@style/Avatar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/person_name"
            style="@style/Text.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/person_subtitle"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Add friend / Requested / Friends -->
    <ImageView
        android:id="@+id/person_action"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/teal_light"
        android:contentDescription="Add friend"
        android:padding="10dp"
        android:src="@drawable/ic_person_add"
        android:tint="@color/teal" />
</LinearLayout>
