<?xml version="1.0" encoding="utf-8"?>
<!-- 05 · Reaction picker: Lina's post dimmed by a scrim, with the reaction bar
     overlapping the bottom edge of the photo and "Love" raised with its tooltip -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reaction_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false">

        <!-- ===== The post underneath ===== -->
        <LinearLayout
            android:id="@+id/post_top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/post_header_bar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp">

                <ImageView
                    android:id="@+id/btn_back"
                    style="@style/Icon.Touch"
                    android:contentDescription="@string/cd_back"
                    android:src="@drawable/ic_back" />

                <TextView
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Lina's post"
                    android:textSize="21sp" />
            </LinearLayout>

            <View
                android:id="@+id/post_header_divider"
                style="@style/Divider"
                android:layout_width="match_parent" />

            <include
                android:id="@+id/post_author"
                layout="@layout/view_post_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/post_text"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/post_body"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/post_photo"
            android:layout_width="0dp"
            android:layout_height="327dp"
            android:layout_marginTop="12dp"
            android:contentDescription="Beach photo"
            android:cropToPadding="true"
            android:scaleType="centerCrop"
            android:src="@drawable/scene_sand"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/post_top" />

        <LinearLayout
            android:id="@+id/post_summary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/post_photo">

            <include layout="@layout/view_reaction_stack" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Aisha Khan and 1.2K others"
                android:textSize="15sp" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="86 comments"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:id="@+id/post_summary_divider"
            style="@style/Divider"
            android:layout_width="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/post_summary" />

        <include
            android:id="@+id/post_actions"
            layout="@layout/view_post_actions"
            android:layout_width="0dp"
            android:layout_height="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/post_summary_divider" />

        <View
            android:id="@+id/post_actions_divider"
            style="@style/Divider.Thick"
            android:layout_width="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/post_actions" />

        <LinearLayout
            android:id="@+id/sort_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/post_actions_divider">

            <TextView
                style="@style/Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Most relevant"
                android:textSize="16sp" />

            <ImageView
                style="@style/Icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/first_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:paddingBottom="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sort_row">

            <TextView
                style="@style/Avatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:backgroundTint="@color/av_crimson"
                android:text="AK"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_bubble"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="9dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <TextView
                    style="@style/Text.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aisha Khan" />

                <TextView
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="That sky is unreal." />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Dim scrim over everything; tapping it dismisses the picker ===== -->
        <View
            android:id="@+id/scrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/scrim"
            android:clickable="true"
            android:contentDescription="@string/cd_close"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ===== Reaction bar, centred on the photo's bottom edge ===== -->
        <LinearLayout
            android:id="@+id/reaction_bar"
            android:layout_width="wrap_content"
            android:layout_height="68dp"
            android:layout_marginStart="14dp"
            android:translationY="34dp"
            android:background="@drawable/bg_reaction_bar"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@id/post_photo"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/react_like"
                style="@style/ReactionIcon"
                android:contentDescription="Like"
                android:src="@drawable/react_like" />

            <!-- Love is focused: bigger, lifted above the bar, with a tooltip -->
            <LinearLayout
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:translationY="-34dp">

                <TextView
                    style="@style/Text.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_tooltip"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Love"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/react_love"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Love"
                    android:src="@drawable/react_love" />
            </LinearLayout>

            <ImageView
                android:id="@+id/react_haha"
                style="@style/ReactionIcon"
                android:contentDescription="Haha"
                android:src="@drawable/react_haha" />

            <ImageView
                android:id="@+id/react_wow"
                style="@style/ReactionIcon"
                android:contentDescription="Wow"
                android:src="@drawable/react_wow" />

            <ImageView
                android:id="@+id/react_sad"
                style="@style/ReactionIcon"
                android:contentDescription="Sad"
                android:src="@drawable/react_sad" />

            <ImageView
                android:id="@+id/react_angry"
                style="@style/ReactionIcon"
                android:contentDescription="Angry"
                android:src="@drawable/react_angry" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
