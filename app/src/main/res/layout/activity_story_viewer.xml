<?xml version="1.0" encoding="utf-8"?>
<!-- 11 · Story viewer: Omar's story with progress, sticker and quick reactions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/dark_pill"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/scene_night_tall" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_track"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_progress_fill" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_track"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_progress_fill" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_track"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.5"
                        android:background="@drawable/bg_progress_fill" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.5" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_track"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="6dp">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/av_green"
                    android:text="OF"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:alpha="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Omar Farooq"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5h · "
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <ImageView
                            style="@style/Icon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_globe"
                            android:tint="@color/white" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    style="@style/Icon.Touch"
                    android:contentDescription="@string/cd_more"
                    android:src="@drawable/ic_more"
                    android:tint="@color/white" />

                <ImageView
                    android:id="@+id/btn_close"
                    style="@style/Icon.Touch"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/cd_close"
                    android:src="@drawable/ic_close"
                    android:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- Text sticker placed on the photo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="0dp"
            android:background="@drawable/bg_sticker_white"
            android:backgroundTint="@color/white"
            android:elevation="2dp"
            android:fontFamily="@font/bricolage_extrabold"
            android:includeFontPadding="false"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:rotation="-3"
            android:text="Karachi nights"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:translationY="222dp" />
    </androidx.cardview.widget.CardView>

    <!-- Reply + quick reactions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input_story_reply"
            style="@style/Text"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_dark_pill"
            android:hint="Send message…"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:textColor="@color/white"
            android:textColorHint="#99FFFFFF"
            android:textSize="16sp" />

        <ImageView
            style="@style/StoryReaction"
            android:contentDescription="Like"
            android:src="@drawable/react_like" />

        <ImageView
            style="@style/StoryReaction"
            android:contentDescription="Love"
            android:src="@drawable/react_love" />

        <ImageView
            style="@style/StoryReaction"
            android:contentDescription="Haha"
            android:src="@drawable/react_haha" />
    </LinearLayout>
</LinearLayout>
