<?xml version="1.0" encoding="utf-8"?>
<!-- 11 · Story viewer: a friend's live stories with progress, label, reply and quick reactions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/story_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/dark_pill"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <!-- The story's photo or video -->
        <ImageView
            android:id="@+id/story_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Story"
            android:scaleType="centerCrop" />

        <VideoView
            android:id="@+id/story_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Text label placed on the story; StoryLabel positions it -->
        <TextView
            android:id="@+id/story_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sticker_white"
            android:backgroundTint="@color/badge_red"
            android:elevation="2dp"
            android:fontFamily="@font/bricolage_extrabold"
            android:includeFontPadding="false"
            android:maxWidth="280dp"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:rotation="2"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:visibility="gone" />

        <!-- Tap the left third to go back, anywhere else to go forward -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <View
                android:id="@+id/story_prev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Previous story" />

            <View
                android:id="@+id/story_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:contentDescription="Next story" />
        </LinearLayout>

        <!-- Progress segments + who posted it -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/story_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/story_owner_avatar"
                    style="@style/Avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/story_owner_name"
                        style="@style/Text.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/story_meta"
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <ImageView
                            android:id="@+id/story_globe"
                            style="@style/Icon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_globe"
                            android:tint="@color/white" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_story_more"
                    style="@style/Icon.Touch"
                    android:contentDescription="@string/cd_more"
                    android:src="@drawable/ic_more"
                    android:tint="@color/white" />

                <ImageView
                    android:id="@+id/btn_close"
                    style="@style/Icon.Touch"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/cd_close"
                    android:src="@drawable/ic_close"
                    android:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Reply + quick reactions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input_story_reply"
            style="@style/Text"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_dark_pill"
            android:hint="Send message…"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:textColor="@color/white"
            android:textColorHint="#99FFFFFF"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/story_react_like"
            style="@style/StoryReaction"
            android:contentDescription="Like"
            android:src="@drawable/react_like" />

        <ImageView
            android:id="@+id/story_react_love"
            style="@style/StoryReaction"
            android:contentDescription="Love"
            android:src="@drawable/react_love" />

        <ImageView
            android:id="@+id/story_react_haha"
            style="@style/StoryReaction"
            android:contentDescription="Haha"
            android:src="@drawable/react_haha" />
    </LinearLayout>
</LinearLayout>
