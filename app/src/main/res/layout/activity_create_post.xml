<?xml version="1.0" encoding="utf-8"?>
<!-- 07 · Create post: composer with audience chips, text colour swatches and an options sheet -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/create_post_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btn_close"
            style="@style/Icon.Touch"
            android:contentDescription="@string/cd_close"
            android:src="@drawable/ic_close" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Create post"
            android:textSize="21sp" />

        <Button
            android:id="@+id/btn_post"
            style="@style/Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Post" />
    </LinearLayout>

    <View style="@style/Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Author + audience -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="JW"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jacob West"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_chip_teal"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="9dp">

                            <ImageView
                                style="@style/Icon"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_globe"
                                android:tint="@color/teal" />

                            <TextView
                                style="@style/Text.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="Public"
                                android:textColor="@color/teal"
                                android:textSize="14sp" />

                            <ImageView
                                style="@style/Icon"
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_marginStart="5dp"
                                android:src="@drawable/ic_chevron_down"
                                android:tint="@color/teal" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_chip_teal"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="9dp">

                            <ImageView
                                style="@style/Icon"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_plus"
                                android:tint="@color/teal" />

                            <TextView
                                style="@style/Text.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="Album"
                                android:textColor="@color/teal"
                                android:textSize="14sp" />

                            <ImageView
                                style="@style/Icon"
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_marginStart="5dp"
                                android:src="@drawable/ic_chevron_down"
                                android:tint="@color/teal" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Post text -->
            <EditText
                android:id="@+id/input_post"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@null"
                android:gravity="top|start"
                android:hint="What's on your mind?"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingExtra="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Weekend plan: coffee, sketching, and absolutely no email."
                android:textSize="22sp" />

            <!-- Background colour swatches -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:orientation="horizontal"
                android:paddingStart="16dp">

                <TextView
                    style="@style/Text.Bold"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_swatch_outline"
                    android:gravity="center"
                    android:text="Aa"
                    android:textSize="13sp" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_swatch"
                    android:backgroundTint="@color/teal" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_swatch"
                    android:backgroundTint="@color/sw_orange" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_swatch"
                    android:backgroundTint="@color/av_indigo" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_swatch"
                    android:backgroundTint="@color/av_green" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_swatch"
                    android:backgroundTint="@color/gold" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_swatch"
                    android:backgroundTint="@color/av_purple" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_swatch"
                    android:backgroundTint="@color/sw_black" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="40dp" />

            <!-- Options sheet with rounded top and soft shadow -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sheet_top"
                android:elevation="16dp"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_grabber" />

                <LinearLayout
                    android:id="@+id/opt_photo"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_image"
                        android:tint="@color/av_green" />

                    <TextView
                        style="@style/Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Photo/video"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/opt_tag"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_tag"
                        android:tint="@color/av_steel" />

                    <TextView
                        style="@style/Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Tag people"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/opt_feeling"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_smile"
                        android:tint="@color/gold" />

                    <TextView
                        style="@style/Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Feeling/activity"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/opt_checkin"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_pin"
                        android:tint="@color/sw_orange" />

                    <TextView
                        style="@style/Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Check in"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/opt_live"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_video"
                        android:tint="@color/av_crimson" />

                    <TextView
                        style="@style/Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Live video"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/opt_camera"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_camera"
                        android:tint="@color/teal" />

                    <TextView
                        style="@style/Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Camera"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/opt_event"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_calendar"
                        android:tint="@color/av_indigo" />

                    <TextView
                        style="@style/Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Create event"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
