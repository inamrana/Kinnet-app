<?xml version="1.0" encoding="utf-8"?>
<!-- 03 · Sign up (step 2 of 3): name, birthday, gender, email, password, terms -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/signup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm"
    android:orientation="vertical">

    <!-- Header: back, title, step counter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/form_side"
        android:paddingEnd="@dimen/form_side">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/Icon.Touch"
            android:layout_marginStart="-10dp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Create account"
            android:textSize="21sp" />

        <TextView
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 2 of 3" />
    </LinearLayout>

    <!-- Step progress: 2 of 3 segments filled -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/form_side"
        android:paddingEnd="@dimen/form_side">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_teal_rect_r3" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_teal_rect_r3" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_grey_rect_r3" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/form_side"
            android:paddingEnd="@dimen/form_side">

            <!-- Question heading with the dashed photo placeholder beside it -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Display"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="What's your name and birthday?"
                    android:textSize="25sp" />

                <FrameLayout
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_marginStart="10dp">

                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/bg_dashed_circle">

                        <ImageView
                            style="@style/Icon"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_person"
                            android:tint="@color/text_secondary" />
                    </FrameLayout>

                    <!-- Camera badge overlapping the bottom-right of the placeholder -->
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/teal"
                        android:contentDescription="@string/cd_photo"
                        android:padding="7dp"
                        android:src="@drawable/ic_camera"
                        android:tint="@color/white" />
                </FrameLayout>
            </LinearLayout>

            <!-- First / last name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/InputBox"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <TextView
                        style="@style/InputLabel"
                        android:text="First name" />

                    <EditText
                        style="@style/InputField"
                        android:autofillHints="personGivenName"
                        android:hint="First name"
                        android:inputType="textPersonName"
                        android:text="Jacob" />
                </LinearLayout>

                <LinearLayout
                    style="@style/InputBox"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1">

                    <TextView
                        style="@style/InputLabel"
                        android:text="Last name" />

                    <EditText
                        style="@style/InputField"
                        android:autofillHints="personFamilyName"
                        android:hint="Last name"
                        android:inputType="textPersonName"
                        android:text="West" />
                </LinearLayout>
            </LinearLayout>

            <!-- Birthday -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.SemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Birthday" />

                <ImageView
                    style="@style/Icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="7dp"
                    android:src="@drawable/ic_info" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="13dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/InputLabel"
                            android:text="Day" />

                        <TextView
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="14"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_down" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="13dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/InputLabel"
                            android:text="Month" />

                        <TextView
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Mar"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_down" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="13dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/InputLabel"
                            android:text="Year" />

                        <TextView
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="2004"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_down" />
                </LinearLayout>
            </LinearLayout>

            <!-- Gender -->
            <TextView
                style="@style/Text.SemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Gender" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:checkedButton="@id/gender_male"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/gender_female"
                    style="@style/GenderOption"
                    android:text="Female" />

                <RadioButton
                    android:id="@+id/gender_male"
                    style="@style/GenderOption"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/figtree_bold"
                    android:text="Male" />

                <RadioButton
                    android:id="@+id/gender_custom"
                    style="@style/GenderOption"
                    android:layout_marginStart="10dp"
                    android:text="Custom" />
            </RadioGroup>

            <!-- Email -->
            <LinearLayout
                style="@style/InputBox"
                android:layout_marginTop="14dp">

                <TextView
                    style="@style/InputLabel"
                    android:text="Email" />

                <EditText
                    style="@style/InputField"
                    android:autofillHints="emailAddress"
                    android:hint="Email"
                    android:inputType="textEmailAddress"
                    android:text="jacob.west@mail.com" />
            </LinearLayout>

            <!-- New password -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/InputLabel"
                        android:text="New password" />

                    <EditText
                        style="@style/InputField"
                        android:autofillHints="newPassword"
                        android:hint="New password"
                        android:inputType="textPassword"
                        android:text="kinnect26!" />
                </LinearLayout>

                <ImageView
                    style="@style/Icon.Touch"
                    android:contentDescription="@string/cd_show_password"
                    android:src="@drawable/ic_eye" />
            </LinearLayout>

            <!-- Password strength meter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_red" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_red" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_grey" />

                <TextView
                    style="@style/Text.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Medium"
                    android:textColor="@color/badge_red"
                    android:textSize="13sp" />
            </LinearLayout>

            <CheckBox
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:button="@drawable/check_selector"
                android:checked="true"
                android:fontFamily="@font/figtree_regular"
                android:paddingStart="10dp"
                android:text="I agree to the Kinnect Terms and Privacy Policy."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_create"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Create account"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? "
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/link_login"
                    style="@style/Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log in"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
