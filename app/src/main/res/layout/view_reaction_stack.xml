<?xml version="1.0" encoding="utf-8"?>
<!-- The top three reactions on a post, overlapping each other (most used is drawn on top) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reaction_stack"
    android:layout_width="wrap_content"
    android:layout_height="22dp"
    android:importantForAccessibility="no">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:id="@+id/reaction_stack_3"
        android:layout_marginStart="30dp"
        android:foreground="@drawable/bg_reaction_ring"
        android:src="@drawable/react_haha" />

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:id="@+id/reaction_stack_2"
        android:layout_marginStart="15dp"
        android:foreground="@drawable/bg_reaction_ring"
        android:src="@drawable/react_love" />

    <ImageView
        android:id="@+id/reaction_stack_1"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:foreground="@drawable/bg_reaction_ring"
        android:src="@drawable/react_like" />
</FrameLayout>
