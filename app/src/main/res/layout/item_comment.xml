<?xml version="1.0" encoding="utf-8"?>
<!-- One comment (design screen 06). Replies show the curved connector and a smaller avatar;
     CommentsActivity switches between the two looks. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Connector from the parent comment, replies only -->
    <ImageView
        android:id="@+id/comment_elbow"
        android:layout_width="28dp"
        android:layout_height="52dp"
        android:layout_marginTop="-30dp"
        android:importantForAccessibility="no"
        android:src="@drawable/thread_elbow"
        android:visibility="gone" />

    <TextView
        android:id="@+id/comment_avatar"
        style="@style/Avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="2dp"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/comment_bubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bubble"
                android:orientation="vertical"
                android:paddingStart="13dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="11dp">

                <TextView
                    android:id="@+id/comment_name"
                    style="@style/Text.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/comment_text"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Like count chip overlapping the bubble's bottom-right corner -->
            <LinearLayout
                android:id="@+id/comment_like_chip"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_reaction_chip"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="3dp"
                android:paddingEnd="7dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:foreground="@drawable/bg_reaction_ring"
                    android:importantForAccessibility="no"
                    android:src="@drawable/react_like" />

                <TextView
                    android:id="@+id/comment_like_count"
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Photo comment -->
        <androidx.cardview.widget.CardView
            android:id="@+id/comment_image_card"
            android:layout_width="180dp"
            android:layout_height="124dp"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/comment_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Photo in comment"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/comment_time"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/comment_like"
                style="@style/Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Like"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/comment_reply"
                style="@style/Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Reply"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
