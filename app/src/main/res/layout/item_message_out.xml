<?xml version="1.0" encoding="utf-8"?>
<!-- A message I sent: optional reply quote, teal bubble or photo, heart reaction, "Edited" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="60dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/msg_reply_label"
        style="@style/Text.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/msg_reply_quote"
        style="@style/ChatBubble.In"
        android:layout_marginTop="5dp"
        android:alpha="0.85"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/msg_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/msg_text"
            style="@style/ChatBubble.Out"
            android:layout_marginStart="12dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/msg_image_card"
            android:layout_width="200dp"
            android:layout_height="140dp"
            android:layout_marginStart="12dp"
            android:visibility="gone"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/msg_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Shared photo"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/msg_heart"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="bottom|start"
            android:background="@drawable/bg_circle"
            android:elevation="2dp"
            android:importantForAccessibility="no"
            android:padding="3dp"
            android:src="@drawable/react_love"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/msg_edited"
        style="@style/Text.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Edited"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
