<?xml version="1.0" encoding="utf-8"?>
<!-- 10 · Story editor: the captured photo or video, text label, share to Your story or Close friends -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/story_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/dark_pill"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <!-- The story's photo or video -->
        <ImageView
            android:id="@+id/story_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Story"
            android:scaleType="centerCrop" />

        <VideoView
            android:id="@+id/story_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Text label placed on the story; StoryLabel positions it -->
        <TextView
            android:id="@+id/story_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sticker_white"
            android:backgroundTint="@color/badge_red"
            android:elevation="2dp"
            android:fontFamily="@font/bricolage_extrabold"
            android:includeFontPadding="false"
            android:maxWidth="280dp"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:rotation="2"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/glass_dark"
            android:contentDescription="@string/cd_close"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:src="@drawable/ic_close"
            android:tint="@color/white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tool_tag"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/glass_dark"
                android:contentDescription="Tag people"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="11dp"
                android:src="@drawable/ic_person_add"
                android:tint="@color/white" />

            <TextView
                android:id="@+id/tool_text"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/glass_dark"
                android:contentDescription="Add text"
                android:fontFamily="@font/figtree_bold"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="Aa"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/tool_sticker"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/glass_dark"
                android:contentDescription="Stickers"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="11dp"
                android:src="@drawable/ic_smile"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/tool_music"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/glass_dark"
                android:contentDescription="Music"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="11dp"
                android:src="@drawable/ic_music"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/tool_effects"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/glass_dark"
                android:contentDescription="Effects"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="11dp"
                android:src="@drawable/ic_sparkle"
                android:tint="@color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/editor_hint"
            style="@style/Text.SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:text="Tap Aa to add text · drag it to move · tap it to change colour"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <!-- Shown while the story uploads -->
        <ProgressBar
            android:id="@+id/editor_progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/white"
            android:visibility="gone" />
    </androidx.cardview.widget.CardView>

    <!-- Share targets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/share_your_story"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dark_pill"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/share_avatar"
                style="@style/Avatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:textSize="10sp" />

            <TextView
                style="@style/Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Your story"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/share_close_friends"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dark_pill"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/online_green"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/ic_star"
                android:tint="@color/white" />

            <TextView
                style="@style/Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Close friends"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_share"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/teal"
            android:contentDescription="@string/cd_share_story"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="14dp"
            android:src="@drawable/ic_arrow_right"
            android:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
