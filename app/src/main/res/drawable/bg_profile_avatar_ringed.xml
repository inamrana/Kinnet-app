<?xml version="1.0" encoding="utf-8"?>
<!-- Another user's profile picture: teal outer ring, white gap, green fill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/teal" />
        </shape>
    </item>
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item android:bottom="9dp" android:left="9dp" android:right="9dp" android:top="9dp">
        <shape android:shape="oval">
            <solid android:color="@color/av_green" />
        </shape>
    </item>
</layer-list>
