<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Typography (Figtree for body, Bricolage Grotesque for display headings) ===== -->
    <style name="Text">
        <item name="android:fontFamily">@font/figtree_regular</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Text.Small">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Text.Medium">
        <item name="android:fontFamily">@font/figtree_medium</item>
    </style>
    <style name="Text.SemiBold">
        <item name="android:fontFamily">@font/figtree_semibold</item>
    </style>
    <style name="Text.Bold">
        <item name="android:fontFamily">@font/figtree_bold</item>
    </style>
    <style name="Text.Link">
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textColor">@color/teal</item>
    </style>
    <style name="Text.Display">
        <item name="android:fontFamily">@font/bricolage_extrabold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Text.Title">
        <item name="android:fontFamily">@font/bricolage_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="Text.Section">
        <item name="android:fontFamily">@font/bricolage_bold</item>
        <item name="android:textSize">19sp</item>
    </style>
    <style name="Text.Name">
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Initials avatar: circle with white bold letters; tint the background per person -->
    <style name="Avatar">
        <item name="android:layout_width">@dimen/avatar_md</item>
        <item name="android:layout_height">@dimen/avatar_md</item>
        <item name="android:background">@drawable/bg_circle</item>
        <item name="android:backgroundTint">@color/teal</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- ===== Buttons ===== -->
    <style name="Widget.Kinnect.Button" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
    <!-- Solid teal, fully rounded -->
    <style name="Button.Primary" parent="Widget.Kinnect.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_height">@dimen/button_height</item>
    </style>
    <!-- Solid teal, 10dp corners (Confirm / Add friend) -->
    <style name="Button.PrimarySquare" parent="Widget.Kinnect.Button">
        <item name="android:background">@drawable/bg_btn_primary_square</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
    </style>
    <!-- Warm grey, 10dp corners (Delete / Edit profile / See more) -->
    <style name="Button.Grey" parent="Widget.Kinnect.Button">
        <item name="android:background">@drawable/bg_btn_grey</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Button.Outline" parent="Widget.Kinnect.Button">
        <item name="android:background">@drawable/bg_btn_outline</item>
        <item name="android:textColor">@color/teal</item>
        <item name="android:layout_height">@dimen/button_height</item>
    </style>

    <!-- Round grey icon button (search / messenger in the headers) -->
    <style name="IconButton">
        <item name="android:layout_width">@dimen/round_button</item>
        <item name="android:layout_height">@dimen/round_button</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/bg_circle</item>
        <item name="android:backgroundTint">@color/surface_pill</item>
        <item name="android:tint">@color/text_primary</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <!-- Bare icon -->
    <style name="Icon">
        <item name="android:layout_width">@dimen/icon</item>
        <item name="android:layout_height">@dimen/icon</item>
        <item name="android:tint">@color/text_primary</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <!-- Clickable bare icon with ripple and a bigger touch target -->
    <style name="Icon.Touch">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:importantForAccessibility">yes</item>
    </style>

    <!-- Rounded input box with a small label on top -->
    <style name="InputBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <style name="InputLabel" parent="Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="InputField" parent="Text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@null</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Divider lines -->
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
    </style>
    <style name="Divider.Thick">
        <item name="android:layout_height">8dp</item>
        <item name="android:background">@color/divider_thick</item>
    </style>

    <!-- Filter pill -->
    <style name="Chip" parent="Text.Bold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Chip.Selected">
        <item name="android:backgroundTint">@color/teal_light</item>
        <item name="android:textColor">@color/teal</item>
    </style>

    <!-- Gender option card: label on the left, radio circle on the right -->
    <style name="GenderOption">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_option_selector</item>
        <item name="android:button">@null</item>
        <item name="android:drawableEnd">@drawable/radio_selector</item>
        <item name="android:fontFamily">@font/figtree_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">11dp</item>
    </style>

    <!-- ===== Story cards on the Home rail ===== -->
    <style name="StoryCard">
        <item name="android:layout_width">104dp</item>
        <item name="android:layout_height">175dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface_pill</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>
    <style name="StoryImage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="StoryShade">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/bg_story_shade</item>
    </style>
    <!-- Avatar circled by a teal + white ring, overlapping the story's top-left -->
    <style name="StoryAvatar" parent="Avatar">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:foreground">@drawable/bg_story_ring</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="StoryName" parent="Text.Bold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">bottom|start</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- One emoji in the reaction picker bar -->
    <style name="ReactionIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- Quick reaction next to the story reply box -->
    <style name="StoryReaction">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- ===== Chat bubbles ===== -->
    <style name="ChatBubble" parent="Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="ChatBubble.In">
        <item name="android:background">@drawable/bg_bubble</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>
    <style name="ChatBubble.Out">
        <item name="android:background">@drawable/bg_bubble_teal</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="TypingDot">
        <item name="android:layout_width">7dp</item>
        <item name="android:layout_height">7dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">@drawable/bg_circle</item>
        <item name="android:backgroundTint">@color/text_secondary</item>
    </style>

    <!-- Top tab icon (Home / Friends / Marketplace / Notifications / Menu) -->
    <style name="TopTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
</resources>
